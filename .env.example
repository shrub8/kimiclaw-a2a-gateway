# Placeholders only. Copy to .env (gitignored) and fill in real values outside version control.
KIMICLAW_TOKEN=<inbound-bearer-token>
GATEWAY_NOTIFY_URL=<n8n-a2a-firewall-webhook-url>
# Must be `basic` for the n8n A2A_Firewall webhook (sends Authorization: Basic base64(user:KIMICLAW_TOKEN)).
GATEWAY_NOTIFY_AUTH_MODE=basic
GATEWAY_NOTIFY_AUTH_USER=<n8n-basic-auth-user>
GATEWAY_NOTIFY_EVENTS=task_completed,task_failed
GATEWAY_NOTIFY_FAIL_LIMIT=5
GATEWAY_NOTIFY_COOLDOWN_S=900
GATEWAY_LOG_PAYLOADS=0
GATEWAY_TELEMETRY_DIR=telemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<otlp-host>:4318   # set = OTLP instead of files; unset = files (daily, 7 days kept)
